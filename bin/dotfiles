#!/bin/zsh

DOTFILES_PATH="$(cd -P "$(dirname "$0")/.." >/dev/null 2>&1 && pwd -P)"
export DOTFILES_PATH
export DOTFILES="$DOTFILES_PATH"

SETUP_FILE="$DOTFILES_PATH/commands/$1.sh"

if [ $# -eq 0 ]
then
  zsh "$DOTFILES_PATH/bootstrap"
elif [ "$1" = "reload" ] && [ -f "$SETUP_FILE" ]
then
  source "$SETUP_FILE"
elif [ -f "$SETUP_FILE" ]
then
  zsh "$SETUP_FILE"
else
  echo "Command doesn't exist"
fi
