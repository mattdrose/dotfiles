# Homebrew
if [ -f /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Dotfiles
export DOTFILES_PATH="$HOME/dotfiles"

# Personal bin
export PATH="$HOME/bin:$PATH"

# PostgreSQL
[ -d "/opt/homebrew/opt/postgresql@16/bin" ] && \
  export PATH="/opt/homebrew/opt/postgresql@16/bin:$PATH"

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
[[ -d "$PYENV_ROOT/bin" ]] && export PATH="$PYENV_ROOT/bin:$PATH"
command -v pyenv >/dev/null && eval "$(pyenv init - zsh --no-rehash)"

# bun
export BUN_INSTALL="$HOME/.bun"
[ -d "$BUN_INSTALL" ] && export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# Android SDK
if [ -d "$HOME/Library/Android/sdk" ]; then
  export ANDROID_HOME="$HOME/Library/Android/sdk"
  export PATH="$PATH:$ANDROID_HOME/emulator"
  export PATH="$PATH:$ANDROID_HOME/platform-tools"
fi

# Java
[ -d "/Library/Java/JavaVirtualMachines/zulu-11.jdk/Contents/Home" ] && \
  export JAVA_HOME="/Library/Java/JavaVirtualMachines/zulu-11.jdk/Contents/Home"

# git-fuzzy
[ -d "$HOME/.git-fuzzy/bin" ] && export PATH="$HOME/.git-fuzzy/bin:$PATH"

# fzf
[ -f "$HOME/.fzf.zsh" ] && source "$HOME/.fzf.zsh"

# zoxide
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# nvm — sourced last and forced to front of PATH so it always wins over Homebrew's node
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"
[ -n "$NVM_BIN" ] && case "$PATH" in
  "$NVM_BIN:"*) ;;
  *) export PATH="$NVM_BIN:$PATH" ;;
esac
