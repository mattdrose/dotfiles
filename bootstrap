#!/bin/zsh

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$0")" && pwd)"

link_file() {
  local src="$1" dest="$2"

  if [ -L "$dest" ]; then
    if [ "$(readlink "$dest")" = "$src" ]; then
      return
    fi
    rm "$dest"
  elif [ -e "$dest" ]; then
    mv "$dest" "$dest.old"
    echo "Backed up $dest → $dest.old"
  fi

  ln -sf "$src" "$dest"
  echo "Linked $dest"
}

init() {
  for file in "$DOTFILES_DIR"/.*; do
    local filename="$(basename "$file")"
    case "$filename" in
      .|..|.git|.DS_Store)
        continue
        ;;
    esac
    link_file "$file" "$HOME/$filename"
  done

  link_file "$DOTFILES_DIR/bin" "$HOME/bin"

  source "$HOME/.zshrc"

  if type tmux >/dev/null 2>/dev/null; then
    tmux source-file "$HOME/.tmux.conf"
  fi
}

if [[ "${1:-}" == "--force" || "${1:-}" == "-f" ]]; then
  init
elif [[ -n "${SPIN:-}" ]]; then
  init
else
  read "REPLY?This will symlink dotfiles to your home directory. Continue? (y/n) "
  if [[ "$REPLY" =~ ^[Yy]$ ]]; then
    init
  fi
fi
